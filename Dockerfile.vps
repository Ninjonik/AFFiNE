# Multi-stage Dockerfile for amd64 that compiles everything inside the container
# syntax=docker/dockerfile:1.7

FROM node:22-bookworm AS builder
WORKDIR /app

# Install Rust and build tools for native module compilation
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    pkg-config \
    libssl-dev \
    ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Install Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain 1.93.1
ENV PATH="/root/.cargo/bin:${PATH}"

# Copy the entire workspace
COPY . .

# Install dependencies
RUN corepack enable && yarn install

# Build native modules for amd64
RUN cargo build --release --target x86_64-unknown-linux-gnu && \
    cp target/x86_64-unknown-linux-gnu/release/libaffine_server_native.so packages/backend/native/server-native.x64.node && \
    cp packages/backend/native/server-native.x64.node packages/backend/native/server-native.arm64.node && \
    cp packages/backend/native/server-native.x64.node packages/backend/native/server-native.armv7.node

# Build frontends using the CLI tool
RUN yarn affine build -p web --deps --wait-deps && \
    yarn affine build -p admin --deps --wait-deps

# Build backend server
RUN yarn affine build -p server --deps --wait-deps && \
    yarn workspace @affine/server prisma generate

# Final stage - runtime image
FROM node:22-bookworm-slim
WORKDIR /app

# Copy built artifacts
COPY --from=builder /app/packages/backend/server /app
COPY --from=builder /app/node_modules/.prisma /app/node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma /app/node_modules/@prisma

# Install runtime dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends openssl libjemalloc2 && \
    rm -rf /var/lib/apt/lists/*

# Run docker-clean script
ARG TARGETARCH=amd64
RUN AFFINE_DOCKER_CLEAN=1 TARGETARCH="${TARGETARCH}" node ./scripts/docker-clean.mjs

# Enable jemalloc
ENV LD_PRELOAD=libjemalloc.so.2

EXPOSE 3010

CMD ["node", "./dist/main.js"]
