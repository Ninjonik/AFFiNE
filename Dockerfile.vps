# Custom Dockerfile for VPS build
FROM node:22-bookworm-slim

WORKDIR /app

# Copy built server package contents directly into /app (matches official Dockerfile structure)
COPY ./packages/backend/server /app
COPY ./packages/frontend/apps/web/dist /app/static
COPY ./packages/frontend/admin/dist /app/static/admin
COPY ./packages/frontend/apps/mobile/dist /app/static/mobile

# Copy workspace node_modules (contains prisma, cli and all deps needed for migration)
COPY ./node_modules /app/node_modules

# Install runtime system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends openssl libjemalloc2 && \
    rm -rf /var/lib/apt/lists/*

# Make sure prisma and other bin tools are found
ENV PATH="/app/node_modules/.bin:${PATH}"

# Enable jemalloc
ENV LD_PRELOAD=libjemalloc.so.2

EXPOSE 3010

CMD ["node", "./dist/main.js"]
